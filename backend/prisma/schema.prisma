// Prisma schema for feature `user-authentication`.
// Source of truth: architecture/user-authentication.md (sha256:c4d6ed2b42747f00b543688f14f231022087a4ee50f1d721f148191429f56f88)
// Do not add/remove fields beyond what that document specifies.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  localCredential  LocalCredential?
  telegramIdentity TelegramIdentity?
}

model LocalCredential {
  id               String    @id @default(uuid())
  userId           String    @unique // 1 local credential / user at MVP (no multi-email/user)
  email            String    @unique // login lookup key — no multi-email required
  passwordHash     String // argon2id encoded string (salt+params embedded in the string, no separate column)
  emailVerifiedAt  DateTime? // null = not verified; OQ-A05 resolved: verification NOT required at MVP, kept nullable for future
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime? // null = not locked; threshold from AUTH_LOGIN_MAX_ATTEMPTS/AUTH_LOGIN_LOCKOUT_MINUTES env, not hardcoded
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model TelegramIdentity {
  id               String    @id @default(uuid())
  userId           String    @unique // 1 Telegram identity / user at MVP
  telegramUserId   BigInt    @unique // Telegram numeric user id — at most 1 User system-wide (BR-002/BR-004)
  telegramUsername String?
  firstName        String?
  lastName         String?
  linkedAt         DateTime  @default(now())
  lastLoginAt      DateTime?

  user User @relation(fields: [userId], references: [id])
}

// Pending login/link request matched by the bot when the user sends /start <code>.
// code is the deep-link start-parameter itself (base64url, high entropy, used directly as PK).
model TelegramLoginRequest {
  code                String    @id // base64url(crypto.randomBytes(32)) — satisfies Telegram's A-Za-z0-9_- / <=64 char constraint (BA EV-008)
  purpose             String // LOGIN | LINK
  linkingUserId       String? // set when purpose=LINK: User.id of the session that was logged in when the request was created
  initiatorSessionSid String // sid of the session (anonymous or logged in) that generated the code — must match at claim time (AC-005c)
  status              String    @default("PENDING") // PENDING | CONFIRMED | CLAIMED | EXPIRED | REJECTED
  telegramUserId      BigInt? // filled when the bot receives a valid /start (status=CONFIRMED)
  telegramUsername    String?
  firstName           String?
  lastName            String?
  createdAt           DateTime  @default(now())
  expiresAt           DateTime // createdAt + technical threshold (default 300s, see Concurrency section)
  confirmedAt         DateTime?
  claimedAt           DateTime?

  @@index([initiatorSessionSid])
}

// Custom session store (PrismaSessionStore implements express-session's Store interface).
// Intentionally not using a small/single-maintainer community package for this simple
// 3-column schema — reduces supply-chain risk, in exchange the backend owns implementing
// get/set/destroy/touch correctly against the interface (deliberate simplification, not an oversight).
model Session {
  sid       String   @id
  data      String // JSON.stringify(session payload); contains userId and loginAt once logged in
  expiresAt DateTime

  @@index([expiresAt]) // for an expired-session cleanup job (on-demand or external cron, out of MVP scope)
}

model AuthAuditLog {
  id                   String   @id @default(uuid())
  userId               String? // null when the user could not be determined (e.g. login with unknown email)
  action               String // REGISTER_LOCAL | LOGIN_LOCAL_SUCCESS | LOGIN_LOCAL_FAILED | LOGIN_LOCAL_LOCKED | TELEGRAM_LOGIN_REQUEST_CREATED | TELEGRAM_LOGIN_CONFIRMED | TELEGRAM_LOGIN_CLAIMED | TELEGRAM_LOGIN_EXPIRED | TELEGRAM_WEBHOOK_REJECTED | LOGOUT | ACCOUNT_LINK_TELEGRAM | ACCOUNT_LINK_LOCAL | ACCOUNT_LINK_REJECTED | RATE_LIMITED
  result               String // SUCCESS | FAILURE | REJECTED
  requestCorrelationId String
  createdAt            DateTime @default(now())
  detailsRedacted      Json? // MUST NEVER contain password/passwordHash/session secret/bot token/session id

  @@index([userId])
}

// Prisma schema addition for feature `binance-read-only-connection`.
// Source of truth: architecture/binance-read-only-connection.md
// (sha256:49b994bf10431bd82b1ce4f4d4f68a80b5ed60baeff29ed754814a3e63e01210)
// Do not add/remove fields beyond what that document specifies, EXCEPT
// `encryptionIvApiSecret` below: the architecture doc's Prisma sketch has a
// single `encryptionIv` shared by both encryptedApiKey and encryptedApiSecret.
// Reusing one AES-256-GCM IV under the same key for 2 different plaintexts is
// a nonce-reuse vulnerability (breaks GCM's confidentiality/integrity
// guarantees), not a business-policy question — fixed during implementation
// by giving apiSecret its own IV column. docs/DATABASE.md records this
// deviation; architecture.md's own revision is unchanged since the fix is a
// crypto-correctness detail, not an AC/behavior/business-rule change.
model BinanceConnection {
  id                    String           @id @default(uuid())
  userId                String // from AuthGuard's req.user.id, never from client body
  label                 String
  encryptedApiKey       Bytes // AES-256-GCM ciphertext
  encryptedApiSecret    Bytes
  encryptionIv          Bytes // IV for encryptedApiKey
  encryptionIvApiSecret Bytes // separate IV for encryptedApiSecret — see model comment
  encryptionKeyVersion  Int // supports key rotation without decrypting everything immediately
  status                ConnectionStatus @default(PENDING_VERIFY)
  accountType           String? // "MARGIN_1" | "MARGIN_2" | null before first verify
  permissionSnapshot    Json? // { enableReading, enableMargin, enableSpotAndMarginTrading, enableWithdrawals, enableFutures, enableVanillaOptions, enablePortfolioMarginTrading, checkedAt } | null if undetermined
  permissionUnknown     Boolean          @default(false) // true when the apiRestrictions call failed — fail-closed flag (COND-003)
  lastError             String?
  lastVerifiedAt        DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  deletedAt             DateTime? // set in the same transaction that nulls out the secret fields on revoke

  @@index([userId])
}

enum ConnectionStatus {
  PENDING_VERIFY
  VERIFIED
  INVALID
  UNSUPPORTED_ACCOUNT_MODE // accountType=MARGIN_2, or account never opened Cross Margin (COND-002: 2 distinct lastError messages, same status)
  VERIFY_UNKNOWN // timeout/network during verify — must NOT be mapped to INVALID
  REVOKED
}

model ConnectionAuditLog {
  id                   String   @id @default(uuid())
  userId               String
  connectionId         String // kept after the connection is revoked, to preserve history — no hard FK
  action               String // CONNECTION_ADDED | VERIFY_ATTEMPTED | VERIFY_SUCCEEDED | VERIFY_FAILED | ACCOUNT_SNAPSHOT_READ | PERMISSION_CHECK_FAILED | CONNECTION_REVOKED
  result               String // SUCCESS | INVALID | UNSUPPORTED_ACCOUNT_MODE | UNKNOWN_TIMEOUT | ERROR
  requestCorrelationId String
  createdAt            DateTime @default(now())
  detailsRedacted      Json? // MUST NEVER contain apiKey/apiSecret, plaintext or ciphertext

  @@index([userId])
  @@index([connectionId])
}

// Prisma schema addition for feature `capital-provenance-ledger`.
// Source of truth: architecture/capital-provenance-ledger.md
// (sha256:da81fdb2a2756da5e4fd9683f793df7aa2c39bd76b8f83917b3a979def7b83a2)
// Do not add/remove fields beyond what that document specifies.
model BorrowPosition {
  id                    String               @id @default(uuid())
  userId                String // from AuthGuard's req.user.id, never from client body
  borrowedAsset         String // free-form (e.g. "ZEC", "WLD") — not an enum, open-ended list
  quantity              Decimal              @db.Decimal(36, 18)
  firstBorrowEntryPrice Decimal              @db.Decimal(36, 18) // immutable — no update endpoint exists for this field
  liabilityLedger       Decimal              @db.Decimal(36, 18) // principal+interest per ledger, units = borrowedAsset
  liabilityBinanceLast  Decimal?             @db.Decimal(36, 18) // snapshot from last reconcile, display/compare only
  reservedAmountUsdt    Decimal              @default(0) @db.Decimal(36, 2)
  status                BorrowPositionStatus @default(OPEN)
  version               Int                  @default(0) // optimistic lock (COND-003)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  repaidAt              DateTime?

  allocationLots AllocationLot[]

  @@index([userId])
  @@index([userId, borrowedAsset])
}

enum BorrowPositionStatus {
  OPEN
  REPAID
  DRIFT_DETECTED
}

enum AllocationAsset {
  BTC
  ETH
}

enum AllocationFundingSource {
  PERSONAL
  BORROW
}

model AllocationLot {
  id                      String                  @id @default(uuid())
  userId                  String
  asset                   AllocationAsset // BTC | ETH only — enum itself rejects SOL at the DB level (AC-009)
  quantity                Decimal                 @db.Decimal(36, 18) // original quantity at purchase
  remainingQuantity       Decimal                 @db.Decimal(36, 18) // decreases on LOT_SOLD
  costBasisUsdt           Decimal                 @db.Decimal(36, 2)
  fundingSource           AllocationFundingSource
  fundingBorrowPositionId String? // required non-null when fundingSource=BORROW (app-level check, BR-003)
  fundingBorrowPosition   BorrowPosition?         @relation(fields: [fundingBorrowPositionId], references: [id])
  version                 Int                     @default(0) // optimistic lock (COND-003)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  @@index([userId])
  @@index([fundingBorrowPositionId])
}

enum LedgerEventType {
  BORROW_OPENED
  ASSET_SOLD
  ASSET_BOUGHT
  LOT_SOLD
  REPAY
  CORRECTION
  DUST_WRITTEN_OFF
}

// Deviation from architecture/capital-provenance-ledger.md (discovered during
// implementation, not a business-policy change): the architecture's
// "Financial formulas" section references a user-declared `personalCapitalUsdt`
// input for the available-capital formula but never specified where it is
// stored. A dedicated single-row-per-user table is the minimal storage for
// that — same spirit as the encryptionIvApiSecret fix in BinanceConnection
// (docs/DATABASE.md records this; architecture.md revision unchanged since
// this is a storage detail, not an AC/behavior/business-rule change).
model PersonalCapitalDeclaration {
  userId     String   @id
  amountUsdt Decimal  @default(0) @db.Decimal(36, 2)
  updatedAt  DateTime @updatedAt
}

model LedgerEvent {
  id               String          @id @default(uuid())
  userId           String
  type             LedgerEventType
  borrowPositionId String?
  allocationLotId  String?
  payload          Json // raw figures the user entered, units documented in payload keys
  correctsEventId  String? // non-null when type=CORRECTION, self-references another LedgerEvent
  idempotencyKey   String // client-generated UUID, guards against double-submit (COND-002)
  createdAt        DateTime        @default(now())

  @@unique([userId, idempotencyKey])
  @@index([userId])
  @@index([borrowPositionId])
  @@index([allocationLotId])
}
