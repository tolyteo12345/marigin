# PostgreSQL connection string used by Prisma. Never commit real credentials.
DATABASE_URL="postgresql://user:password@localhost:5432/margin_trading?schema=public"

# Secret used to sign the express-session cookie. Generate a long random value per environment.
SESSION_SECRET="change-me-to-a-long-random-value"

# Telegram bot credentials (bot created/owned by the operator via BotFather — see OQ-A10).
TELEGRAM_BOT_TOKEN="123456:ABC-DEF..."
TELEGRAM_BOT_USERNAME="your_bot_username"
TELEGRAM_WEBHOOK_SECRET_TOKEN="change-me-to-a-long-random-value"
TELEGRAM_WEBHOOK_URL="https://your-public-domain.example.com/api/auth/telegram/webhook"

# Login lockout policy (BR-010 / OQ-A07 resolved).
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_LOCKOUT_MINUTES=15
