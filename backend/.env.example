# PostgreSQL connection string used by Prisma. Never commit real credentials.
DATABASE_URL="postgresql://user:password@localhost:5432/margin_trading?schema=public"

# Secret used to sign the express-session cookie. Generate a long random value per environment.
SESSION_SECRET="change-me-to-a-long-random-value"

# Telegram bot credentials (bot created/owned by the operator via BotFather — see OQ-A10).
# No webhook URL/secret needed (r4): backend receives /start <code> via long-polling (getUpdates).
TELEGRAM_BOT_TOKEN="123456:ABC-DEF..."
TELEGRAM_BOT_USERNAME="your_bot_username"

# Login lockout policy (BR-010 / OQ-A07 resolved).
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_LOCKOUT_MINUTES=15

# Master key for envelope-encrypting BinanceConnection.encryptedApiKey/encryptedApiSecret
# (feature binance-read-only-connection, AES-256-GCM). Must be base64 of exactly 32 raw
# bytes. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# MVP simplification: single env-provided master key, not a KMS/OS keystore — see
# secret-vault.service.ts comment for the upgrade path (key rotation via encryptionKeyVersion).
BINANCE_SECRET_ENCRYPTION_KEY="change-me-to-a-base64-32-byte-key"
